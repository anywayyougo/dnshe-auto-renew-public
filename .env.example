# 复制本文件为 .env 并填入真实值。.env 已被 gitignore，不会提交到仓库。
# GitHub Actions 中请改用仓库 Secrets 配置同名变量（Settings -> Secrets and variables -> Actions）。

# DNSHE 多账号密钥（1~10，按需填写；Key 和 Secret 必须成对）
DNSHE_API_KEY_1=
DNSHE_API_SECRET_1=
DNSHE_API_KEY_2=
DNSHE_API_SECRET_2=

# 飞书群机器人 Webhook 地址（必填，用于接收通知）
FEISHU_WEBHOOK_URL=

# 飞书签名校验密钥（可选：若机器人开启了"签名校验"则填写，否则留空）
FEISHU_SIGN_SECRET=
